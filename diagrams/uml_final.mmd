classDiagram
    class Owner {
        +owner_id: int
        +name: str
        +pets: list~Pet~
        +add_pet(pet: Pet)
        +get_pets()
        +get_all_tasks()
    }

    class Pet {
        +pet_id: int
        +name: str
        +age: int
        +breed: str
        +tasks: list~Task~
        +add_task(task: Task)
        +get_tasks()
    }

    class Task {
        +title: str
        +due_date: date/datetime
        +priority: str
        +recurrence_frequency: str
        +duration_minutes: int
        +completed: bool
        +mark_complete()
    }

    class Scheduler {
        +owner: Owner
        +tasks: list~Task~
        +__init__(owner: Owner)
        -_refresh_tasks()
        +add_task(task: Task)
        +sort_by_time()
        +sort_tasks()
        +filter_tasks(pet_name, completed)
        +mark_task_complete(task: Task)
        +detect_conflicts()
        +get_conflict_warnings()
        -_pet_for_task(task: Task)
        +get_upcoming_tasks()
    }

    Owner "1" *-- "0..*" Pet : manages
    Pet "1" *-- "0..*" Task : has
    Scheduler "1" --> "1" Owner : works with
    Scheduler "1" o-- "0..*" Task : tracks
